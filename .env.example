# Supabase — valori del tuo progetto (Project Settings > API)
# Le VITE_* sono esposte al browser: usa URL e chiave *publishable*, mai la service-role.
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Solo lato server (non esporre al browser)
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# Solo per le migrazioni Drizzle (drizzle-kit)
# DATABASE_MIGRATION_URL="postgresql://postgres:password@host:5432/postgres"
